      "name": "operations-staged-phone",
      "path": "/design-council-preview?surface=operations&theme=dark",
      "variants": [
        "mobile-light"
      ],
      "viewportOnly": true,
      "actions": [
        {
          "click": "button[aria-label=\"Filter research rows\"]"
        },
        {
          "click": "[role=\"dialog\"] button:text-is(\"Canonical people\")"
        },
        {
          "click": "[role=\"dialog\"] button:text-is(\"Ready to review\")"
        }
      ],
      "capabilities": [
        {
          "can": "stage more than one facet before Apply",
          "text": "Apply"
        }
      ]
    },
