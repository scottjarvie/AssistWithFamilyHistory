# Discover Their Stories - Environment Variables Example
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ===========================================
# REQUIRED
# ===========================================

# OpenRouter API Key (Required for AI features)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Clerk Authentication (Required for protected workspace routes)
# Create an app at: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# Clerk -> Convex auth. Issuer URL of the "convex" JWT template.
# Server/backend only — NOT NEXT_PUBLIC. Must ALSO be set on the Convex
# deployment and in Vercel. See the guarded rollout runbook.
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Convex tenant boundary. Mirror this server-only value in Vercel and Convex.
# Only exact "enforce" denies calls; unset/unknown values default to shadow.
TRUST_BOUNDARY_MODE=shadow

# Convex-only comma-separated Clerk subjects allowed to read the shadow summary.
# Set with: pnpm exec convex env set TRUST_BOUNDARY_SUPER_ADMIN_IDS 'user_...'
# TRUST_BOUNDARY_SUPER_ADMIN_IDS=user_your-superadmin-clerk-id

# Optional Clerk route hints
# CLERK_SIGN_IN_URL=/sign-in
# CLERK_SIGN_UP_URL=/sign-up

# Clerk auto-enables when valid pk_/sk_ keys are present (see lib/clerk/config.ts).
# Force Clerk OFF even when keys are present (kill switch). Server + public twins.
# DISABLE_CLERK=false
# NEXT_PUBLIC_DISABLE_CLERK=false

# In local development (NODE_ENV=development) Clerk stays OFF unless you opt in.
# Set either flag to "true" to enable Clerk while developing locally. Server + public twins.
# ENABLE_CLERK_DEV=false
# NEXT_PUBLIC_ENABLE_CLERK_DEV=false

# Public beta auth posture
# Require sign-in for all private app/API vault routes in deployed beta.
REQUIRE_AUTH=true

# Guest vaults are disabled by default. Enable only for an explicit preview deployment.
# ALLOW_ANONYMOUS_VAULT=false
# NEXT_PUBLIC_ALLOW_ANONYMOUS_VAULT=false

# ===========================================
# OPTIONAL
# ===========================================

# Default AI Model
# Available models: https://openrouter.ai/models
# Examples:
#   - anthropic/claude-sonnet-4-20250514 (recommended)
#   - openai/gpt-4o
#   - openai/gpt-4o-mini (cheaper)
#   - google/gemini-2.0-flash-001 (fastest)
# OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514

# Site URL for OpenRouter tracking
# Helps with rate limiting and usage tracking
# OPENROUTER_SITE_URL=http://localhost:3443

# Public site URL used for canonical tags, sitemaps, and metadata.
# Set this in production to your deployed hostname.
NEXT_PUBLIC_SITE_URL=http://localhost:3443

# Convex URL (required for Convex-backed documents/stats APIs)
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Experimental tools lab flags. Hidden experiments appear only when set to true.
# EXPERIMENT_TIMELINE_BUILDER=false
# EXPERIMENT_PHOTO_ANALYZER=false
# EXPERIMENT_FAMILY_REVIEW=false
# EXPERIMENT_ANCESTOR_MAPS=false

# App name shown in OpenRouter dashboard
# OPENROUTER_APP_NAME=Discover Their Stories

# ===========================================
# IMAGE / MEDIA STORAGE (Backblaze B2)
# ===========================================
# Self-hosted media on Backblaze B2 (S3-compatible). Server-only — NEVER
# NEXT_PUBLIC. The USER creates a Public bucket + a Read/Write app key scoped to
# it in the B2 dashboard, then pastes the values here and into the hosting env
# (Vercel Production + Preview). See lib/storage/objectStore.ts. If these are
# unset, media falls back to existing/external URLs (no upload path).
# B2_KEY_ID=
# B2_APPLICATION_KEY=                 # secret — mark "Sensitive" in the host
# B2_BUCKET=discover-their-stories-media
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# Public serving base (no trailing slash). B2-direct for now; later swap to a
# Cloudflare host (e.g. https://images.<domain>) WITHOUT re-uploading anything.
# CDN_PUBLIC_BASE=https://f004.backblazeb2.com/file/discover-their-stories-media

# ===========================================
# DEVELOPMENT
# ===========================================

# Enable debug logging
# DEBUG=true

# Skip pacing delays in extraction (admin mode)
# ADMIN_MODE=false
